{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "installCommand": "bash tool/vercel_install.sh",
  "buildCommand": "bash tool/vercel_build.sh",
  "outputDirectory": "build/web",
  "functions": {
    "api/video-transcode.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://vplgtcguxujxwrgguxqq.supabase.co/functions/v1/seo-sitemap"
    },
    {
      "source": "/listing/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|LinkedInBot|TelegramBot|Pinterestbot|SkypeUriPreview|Applebot|Googlebot|bingbot|Embedly|Redditbot|iMessagePreview).*"
        }
      ],
      "destination": "https://vplgtcguxujxwrgguxqq.supabase.co/functions/v1/link-preview/listing/:id"
    },
    {
      "source": "/profile/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|LinkedInBot|TelegramBot|Pinterestbot|SkypeUriPreview|Applebot|Googlebot|bingbot|Embedly|Redditbot|iMessagePreview).*"
        }
      ],
      "destination": "https://vplgtcguxujxwrgguxqq.supabase.co/functions/v1/link-preview/profile/:id"
    },
    {
      "source": "/explore/events/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|LinkedInBot|TelegramBot|Pinterestbot|SkypeUriPreview|Applebot|Googlebot|bingbot|Embedly|Redditbot|iMessagePreview).*"
        }
      ],
      "destination": "https://vplgtcguxujxwrgguxqq.supabase.co/functions/v1/link-preview/event/:id"
    },
    {
      "source": "/explore/eventos/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|LinkedInBot|TelegramBot|Pinterestbot|SkypeUriPreview|Applebot|Googlebot|bingbot|Embedly|Redditbot|iMessagePreview).*"
        }
      ],
      "destination": "https://vplgtcguxujxwrgguxqq.supabase.co/functions/v1/link-preview/event/:id"
    },
    {
      "source": "/u/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|LinkedInBot|TelegramBot|Pinterestbot|SkypeUriPreview|Applebot|Googlebot|bingbot|Embedly|Redditbot|iMessagePreview).*"
        }
      ],
      "destination": "https://vplgtcguxujxwrgguxqq.supabase.co/functions/v1/link-preview/profile/:id"
    },
    {
      "source": "/s/listing/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|LinkedInBot|TelegramBot|Pinterestbot|SkypeUriPreview|Applebot|Googlebot|bingbot|Embedly|Redditbot|iMessagePreview).*"
        }
      ],
      "destination": "https://vplgtcguxujxwrgguxqq.supabase.co/functions/v1/link-preview/listing/:id"
    },
    {
      "source": "/s/profile/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|LinkedInBot|TelegramBot|Pinterestbot|SkypeUriPreview|Applebot|Googlebot|bingbot|Embedly|Redditbot|iMessagePreview).*"
        }
      ],
      "destination": "https://vplgtcguxujxwrgguxqq.supabase.co/functions/v1/link-preview/profile/:id"
    },
    {
      "source": "/s/event/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|LinkedInBot|TelegramBot|Pinterestbot|SkypeUriPreview|Applebot|Googlebot|bingbot|Embedly|Redditbot|iMessagePreview).*"
        }
      ],
      "destination": "https://vplgtcguxujxwrgguxqq.supabase.co/functions/v1/link-preview/event/:id"
    },
    {
      "source": "/((?!api/|\\.well-known/|apple-app-site-association$|account-deletion\\.html$|robots\\.txt$|sitemap\\.xml$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/flutter_bootstrap.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/main.dart.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/canvaskit/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/flutter_service_worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
